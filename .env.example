PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./data/arundhati.db

# Upload limits
MAX_PHOTO_SIZE_MB=5
MAX_DOC_SIZE_MB=10

# CORS origin (frontend dev URL)
CORS_ORIGIN=http://localhost:5173

# Astrology service (Python/FastAPI)
ASTRO_SERVICE_URL=https://arundati-kundali-backend-n8q1.onrender.com
